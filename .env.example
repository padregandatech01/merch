NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-side only (a username alias, not a password)
ADMIN_LOGIN_EMAIL=your-real-admin-email
# Trusted public application origin used in email redirects
APP_ORIGIN=http://localhost:3000
# Server-only. Required for supplier invitations and admin application review.
SUPABASE_SECRET_KEY=your-server-only-secret-key
